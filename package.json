{
  "name": "grabb-it",
  "version": "1.0.0",
  "description": "GRABB-IT Full-Stack E-Commerce Clothing Website",
  "main": "server/server.js",
  "scripts": {
    "postinstall": "npm install --prefix client",
    "setup": "npm install && npm install --prefix client",
    "seed": "node server/database/seed.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build && node -e \"require('fs').cpSync('dist', '../dist', {recursive: true})\"",
    "start": "node server/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": [],
  "author": "Antigravity",
  "license": "ISC"
}
